# Скопируйте этот файл в .env.local и заполните значениями из Supabase:
# Project Settings → API → Project URL и anon public key.
#
# Пока переменные не заданы, приложение работает локально (localStorage).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Только для сборки под GitHub Pages (проектный сайт):
# VITE_BASE=/study-tracker/
